# Barcode Data Portal - Environment Configuration
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For local development, you'll need access to a Couchbase instance
# with the barcode data. Contact the team for credentials.

# =============================================================================
# Required - Couchbase Connection
# =============================================================================
COUCHBASE_ENDPOINT=couchbase://localhost
COUCHBASE_USER=
COUCHBASE_PASSWORD=

# =============================================================================
# Required - Redis (use 'redis' for docker-compose, 'localhost' otherwise)
# =============================================================================
REDIS_HOST=redis

# =============================================================================
# Optional - Application Settings
# =============================================================================
# Environment name (development, staging, production)
APP_ENVIRONMENT=development

# =============================================================================
# Optional - NCBI API Credentials
# For higher rate limits when querying NCBI databases
# Register at: https://www.ncbi.nlm.nih.gov/account/
# =============================================================================
NCBI_API_KEY=
NCBI_API_EMAIL=
